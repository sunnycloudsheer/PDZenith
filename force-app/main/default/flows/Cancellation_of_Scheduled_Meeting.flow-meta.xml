    <decisions>
        <description>This decision element checks the Service Appointment Status Category. If the status is Cancelled, only the confirmation screen is shown and no further action is performed.</description>
        <name>Check_Service_Appointment_Status_Category</name>
        <label>Check Service Appointment Status Category</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Confirmation_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Status_Is_Not_Cancelled</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Service_Appointment_Record.StatusCategory</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Canceled</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Cancel_Scheduled_Meeting</targetReference>
            </connector>
            <label>Status Is Not Cancelled</label>
        </rules>
    </decisions>
    <description>This flow is used to manage the cancellation of a scheduled Service Appointment meeting. It retrieves the Service Appointment details, checks the current Status Category, displays meeting details for review, allows the user to select cancellation status and reason, performs the cancellation action when applicable, and shows a confirmation screen once the meeting is cancelled. It also sets the Date/Time of Cancellation field when flow is completed.</description>
    <environments>Default</environments>
    <formulas>
        <name>dynamicCancellationStatus</name>
        <dataType>String</dataType>
        <expression>CASE(
    {!UserProfileName},
    &apos;Student&apos;, &apos;Meeting Canceled by Student&apos;,
    &apos;Parent&apos;, &apos;Meeting Canceled by Parent&apos;,
    &apos;Meeting Canceled by Educational Strategist&apos;
)</expression>
    </formulas>
    <formulas>
        <name>errorMessage</name>
        <dataType>String</dataType>
        <expression>{!$Flow.FaultMessage}</expression>
    </formulas>
    <formulas>
        <name>UserProfileName</name>
        <dataType>String</dataType>
        <expression>{!$Profile.Name}</expression>
    </formulas>
    <formulas>
        <name>ValidationForCancellationReason</name>
        <dataType>Boolean</dataType>
        <expression>AND(
    NOT(ISBLANK({!Cancellation_Status})),
    ISBLANK({!Reason_For_Cancellation})
)</expression>
    </formulas>
    <interviewLabel>Cancellation of Scheduled Meeting {!$Flow.CurrentDateTime}</interviewLabel>
    <isAdditionalPermissionRequiredToRun>true</isAdditionalPermissionRequiredToRun>
    <label>Cancellation of Scheduled Meeting</label>
