<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Reset_to_Not_Started</name>
        <label>Reset to &quot;Not Started&quot;</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Get_Student_Contact_Record.Onboarding_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Not Started</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Get_Student_Contact_Record.Onboarding_Completed_Date_Time__c</assignToReference>
            <operator>Assign</operator>
        </assignmentItems>
        <connector>
            <targetReference>Update_Contact_First_MeetingStatus_Not_Started</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_First_Meeting_Completed</name>
        <label>Set First Meeting &quot;Completed&quot;</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Get_Student_Contact_Record.Onboarding_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Completed</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Get_Student_Contact_Record.Onboarding_Counselor__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Educational_Strategist__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Get_Student_Contact_Record.Onboarding_Completed_Date_Time__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.SchedEndTime</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Contact_First_Meeting_Status_Complete</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_First_Meeting_Scheduled</name>
        <label>Set First Meeting &quot;Scheduled&quot;</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Get_Student_Contact_Record.Onboarding_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Scheduled</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Get_Student_Contact_Record.Counselor__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Educational_Strategist__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Get_Student_Contact_Record.Onboarding_Completed_Date_Time__c</assignToReference>
            <operator>Assign</operator>
        </assignmentItems>
        <connector>
            <targetReference>Update_Contact_First_Meeting_Status_Scheduled</targetReference>
        </connector>
    </assignments>
    <decisions>
        <description>This prevents an old counselor’s appointment from flipping the student’s onboarding status.</description>
        <name>Counselor_matches_current</name>
        <label>Counselor matches current?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Match</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Student_Contact_Record.OwnerId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Educational_Strategist__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>First_Meeting_Status</targetReference>
            </connector>
            <label>Match</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_3</name>
        <label>Reset status?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes4</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Student_Contact_Record.Onboarding_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Scheduled</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Student_Contact_Record.Onboarding_Completed_Date_Time__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Reset_to_Not_Started</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>First_Meeting_Status</name>
        <label>First Meeting Status?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>First_Meeting_Scheduled</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Scheduled</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_First_Meeting_Scheduled</targetReference>
            </connector>
            <label>First Meeting Scheduled</label>
        </rules>
        <rules>
            <name>First_Meeting_Completed</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Just Student Present</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Student &amp; Parent Present</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Student &amp; Parent 5+ mins late</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Just Student 5+ mins late</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_First_Meeting_Completed</targetReference>
            </connector>
            <label>First Meeting Completed</label>
        </rules>
        <rules>
            <name>Canceled_No_Show</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>No Show (15+ mins late)</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Meeting Canceled by Student</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Meeting Canceled by Parent</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Meeting Cancelled by Educational Strategist</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Canceled</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Decision_3</targetReference>
            </connector>
            <label>Canceled / No Show</label>
        </rules>
    </decisions>
    <description>Updates a student’s onboarding status on the Contact record based on the lifecycle of a First Meeting (60-minute) Service Appointment. Sets onboarding to Scheduled or Completed as appropriate, ignores cancellations and no-shows, and only updates the Contact when the appointment counselor matches the student’s current counselor.</description>
    <environments>Default</environments>
    <formulas>
        <name>isNew</name>
        <dataType>Boolean</dataType>
        <expression>isNew()</expression>
    </formulas>
    <interviewLabel>Service Apppointment {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Service Appointment - Update Contact Onboarding Status (First Meeting) Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Student_Contact_Record</name>
        <label>Get Student Contact Record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Counselor_matches_current</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ContactId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Contact</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Contact_First_Meeting_Status_Complete</name>
        <label>Update Contact - First Meeting Status - Complete</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputReference>Get_Student_Contact_Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Contact_First_Meeting_Status_Scheduled</name>
        <label>Update Contact - First Meeting Status - Scheduled</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputReference>Get_Student_Contact_Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Contact_First_MeetingStatus_Not_Started</name>
        <label>Update Contact - First MeetingStatus - Not Started</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputReference>Get_Student_Contact_Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Student_Contact_Record</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Meeting_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>First Meeting - 60 min.</stringValue>
            </value>
        </filters>
        <filters>
            <field>ContactId</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Educational_Strategist__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>ServiceAppointment</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
