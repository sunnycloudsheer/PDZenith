    <assignments>
        <name>Set_Next_Meeting_At</name>
        <label>Set Next Meeting At</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Get_Student_Contact_Record.Next_Meeting_At__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Next_Meeting.SchedStartTime</elementReference>
