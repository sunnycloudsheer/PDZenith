    <decisions>
        <description>In this component, we check the user’s profile. If the profile is associated with a Standard Platform license, the process continues with the implementation; otherwise, the system exits and follows the default flow.</description>
        <name>Check_User_Profile</name>
        <label>Check User Profile</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Profile_Matched</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Profile.Name</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Student</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Profile.Name</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Parent</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Service_Resource_For_User</targetReference>
            </connector>
            <label>Profile Matched</label>
        </rules>
    </decisions>
    <decisions>
        <description>This decision checks whether a skill set exists for the counsellor. If a skill set is found, the process continues; otherwise, the flow ends.</description>
        <name>Skill_Set_Found_For_Counsellor</name>
        <label>Skill Set Found For Counsellor</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Skill_Set_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Skill_Set</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Profile.Name</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Program Director</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Skills_Set_For_Service_Resource</targetReference>
            </connector>
            <label>Skill Set Found</label>
        </rules>
        <rules>
            <name>profile_Name</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Profile.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Program Director</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Copy_1_of_Get_Regular_Appointment</targetReference>
            </connector>
            <label>profile Name</label>
        </rules>
    </decisions>
